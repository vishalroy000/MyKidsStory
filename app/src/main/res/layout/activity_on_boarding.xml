<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@drawable/onboarding_bg"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_above="@+id/relativelayout"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never" />
    <RelativeLayout
        android:layout_width="match_parent"
        android:id="@+id/relativelayout"
        android:layout_alignParentBottom="true"
        android:layout_height="150dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/btn_next_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/onboarding_button_bg" />

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next ➜"
                android:gravity="center"
                android:fontFamily="@font/akaya_kanadaka_regular"
                android:layout_centerInParent="true"
                android:textColor="#ffffff"
                android:textSize="32sp"
                android:shadowColor="#302F2F"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/text_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:fontFamily="@font/akaya_kanadaka_regular"
            android:text="Skip"
            android:textColor="@color/white"
            android:textSize="24sp" />
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:tabGravity="center"
            android:background="#00111111"
            app:tabIndicatorHeight="0dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="10dp"
            app:tabBackground="@drawable/onboarding_viewpager_selector_blue"/>


    </RelativeLayout>




















